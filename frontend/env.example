# Next.js frontend envs
# Backend API base URL
# Browser API calls should default to same-origin /api through Next rewrites.
# Only set this if you intentionally want browsers to call a separate public API.
NEXT_PUBLIC_BACKEND_URL=
BACKEND_URL=http://127.0.0.1:3101

# Optional: Charts base URL for front-end direct links (if served via HTTP)
# If not provided, the app will use raw ChartPath values returned from backend
# Example: http://localhost:8080/charts
NEXT_PUBLIC_CHART_BASE_URL=

# NextAuth (Google)
#NEXTAUTH_URL=http://localhost:3100
#NEXTAUTH_SECRET=replace-with-random-secret
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
