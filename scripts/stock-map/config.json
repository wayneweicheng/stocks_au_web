{
  "name": "stock-map",
  "runner_url": "http://192.168.20.112:3205",
  "endpoint": "/api/jobs/stock-map",
  "token_env": "SKILL_RUNNER_API_TOKEN",
  "token_dotenv": "backend/.env",
  "http_timeout_seconds": 20,
  "market_flow": {
    "base_url": "http://localhost:3101",
    "username_env": "ADMIN_USERNAME",
    "password_env": "ADMIN_PASSWORD",
    "credentials_dotenv": "backend/.env",
    "timeout_seconds": 20
  },
  "processed_state_file": "logs/stock-map-scheduler/processed.json",
  "log_directory": "logs/stock-map-scheduler",
  "log_filename_format": "scheduler-%Y%m%d-%H%M%S-{pid}.log",
  "current_time": {
    "timezone": "Australia/Sydney",
    "format": "%Y-%m-%d %H:%M"
  },
  "batch": {
    "placeholder": "stock_code",
    "values": [
      "QQQ",
      "SOXL",
      "SOXS",
      "NVDA",
      "TSLA",
      "MU",
      "META",
      "AAPL",
      "ADBE",
      "AMAT",
      "AMD",
      "AMZN",
      "ASML",
      "AVGO",
      "BAC",
      "CEG",
      "COST",
      "CRWD",
      "CRWV",
      "DELL",
      "DIS",
      "DRAM",
      "EWY",
      "FCX",
      "FORM",
      "GDX",
      "GEV",
      "GLD",
      "GOOG",
      "HPE",
      "IGV",
      "INTC",
      "IWM",
      "JPM",
      "KWEB",
      "LITE",
      "LRCX",
      "MCD",
      "MRVL",
      "MSFT",
      "NFLX",
      "ORCL",
      "OXY",
      "PANW",
      "PLTR",
      "QCOM",
      "SKHY",
      "SLV",
      "SMCI",
      "SNDK",
      "SNOW",
      "SOXX",
      "SPY",
      "SPCX",
      "SPXL",
      "SPXU",
      "SQQQ",
      "TLT",
      "TQQQ",
      "TSM",
      "VST",
      "WDC",
      "XBI",
      "XLE",
      "XOM",
      "ZS"
    ],
    "delay_seconds": 30
  },
  "payload": {
    "stock_code": "{{stock_code}}",
    "as_at": "{{current_time}} Australia/Sydney",
    "timeout_minutes": 120
  }
}
